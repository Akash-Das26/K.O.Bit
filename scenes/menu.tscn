centered = false

[node name="Dim" type="ColorRect" parent="."]
offset_right = 600.0
offset_bottom = 240.0
color = Color(0, 0, 0, 0.45)

[node name="Title" type="Label" parent="."]
offset_right = 600.0
offset_bottom = 48.0
