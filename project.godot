; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fighter"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

Fx="*res://scripts/fx.gd"
GameState="*res://scripts/game_state.gd"
Music="*res://scripts/music.gd"
Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=600
window/size/viewport_height=240
window/size/resizable=false
window/size/window_width_override=1200
window/size/window_height_override=480
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/size/viewport_width_override=1200
window/size/viewport_height_override=480

